# Affiliate IDs — sign up, then copy this file to .env
# Travelpayouts (Aviasales/WayAway): https://www.travelpayouts.com
VITE_TP_MARKER=

# Kiwi.com Tequila affiliate: https://tequila.kiwi.com
VITE_KIWI_AFFIL_ID=

# Stripe Payment Links for Ai2Fly Pro. Defaults in src/pages/Pro.tsx point at
# the Spin State Labs SANDBOX links; set these to live-mode links to charge real cards.
VITE_STRIPE_LINK_MONTHLY=
VITE_STRIPE_LINK_YEARLY=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Unset = analytics fully off.
VITE_GA_MEASUREMENT_ID=

# Flight data provider: mock (default) | travelpayouts (real cached prices)
# 'travelpayouts' needs the server-side vars below set in Netlify.
VITE_FLIGHT_PROVIDER=mock

# Server-side (Netlify Functions only, never exposed to the browser):
# Travelpayouts Data API token + affiliate marker — https://www.travelpayouts.com
TRAVELPAYOUTS_TOKEN=
TP_MARKER=
